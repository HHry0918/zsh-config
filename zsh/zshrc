# OSC 52 clipcopy for headless/ssh sessions. oh-my-zsh's clipboard.zsh only knows how to
# talk to a clipboard daemon on the machine zsh itself is running on (pbcopy, xclip/xsel
# gated on $DISPLAY, wl-copy, ...) — none of that exists on a box you're ssh'd into, and
# even if xclip were installed there it would write to that box's own X clipboard, not
# the one you paste into locally. OSC 52 instead hands the payload to the terminal
# emulator as an escape sequence; the terminal (running on the machine you're physically
# at) puts it on the local clipboard, no daemon or packages required, and it survives any
# number of ssh hops. Defined after sourcing oh-my-zsh so it overrides its lazy
# clipcopy/clippaste stubs (clipboard.zsh:103) rather than being overridden by them.
# Left alone on a real desktop session (DISPLAY/WAYLAND_DISPLAY set, or macOS) — there
# oh-my-zsh's native pbcopy/xclip/wl-copy path already works and is preferable.
if [[ -z ${DISPLAY:-} && -z ${WAYLAND_DISPLAY:-} && $OSTYPE != darwin* ]]; then
  function clipcopy() {
    emulate -L zsh
    local data b64
    data=$(cat "${1:-/dev/stdin}"; echo x)
    data=${data%x}
    b64=$(print -rn -- "$data" | base64 | tr -d '\n')
    # xterm's OSC 52 handler caps the escape sequence at 100000 bytes total; refuse well
    # before that rather than silently truncating the clipboard contents.
    if (( ${#b64} > 74000 )); then
      print -u2 "clipcopy: input too large for OSC 52 (${#b64} b64 bytes > 74000 limit)"
      return 1
    fi
    # Write to the tty, not stdout, so `cmd | clipcopy` doesn't leak the escape sequence
    # into whatever comes after clipcopy in the pipeline.
    print -n -- $'\e]52;c;'"$b64"$'\a' > /dev/tty
  }
  # No clippaste here: the OSC 52 read form (\e]52;c;?\a) is disabled by default in
  # essentially every terminal emulator as an anti-exfiltration measure, so there's
  # nothing reliable to call. oh-my-zsh's tmux-buffer fallback (clipboard.zsh:85) still
  # applies when inside tmux; outside tmux, clippaste keeps failing as before.
fi

