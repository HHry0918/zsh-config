# --display-host: p10k decides whether to show "user@host" while ~/.p10k.zsh sources
# below (its own config is compiled once, not re-read later — see the conditional at
# that file's context section), so ZSH_CONFIG_DISPLAY_HOST must be visible *before*
# that source line. install.sh only ever writes it into ~/.zshrc.local, which normally
# sources at the very end of this file — too late. Read *only* that one line early,
# rather than sourcing the whole (arbitrary, user-owned) file twice.
if [[ -f ~/.zshrc.local ]]; then
  ZSH_CONFIG_DISPLAY_HOST=$(grep -oP '(?<=^export ZSH_CONFIG_DISPLAY_HOST=).*' ~/.zshrc.local 2>/dev/null | tail -1)
  [[ -n $ZSH_CONFIG_DISPLAY_HOST ]] && export ZSH_CONFIG_DISPLAY_HOST
fi

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
if [[ -f ~/.p10k.zsh ]]; then
  source ~/.p10k.zsh
fi

# Atuin is optional; Ctrl+R stays and Up stays with fzf.
[[ -f "$HOME/.atuin/bin/env" ]] && source "$HOME/.atuin/bin/env"
if command -v atuin >/dev/null; then
  eval "$(atuin init zsh --disable-ctrl-r --disable-up-arrow)"
fi

# Per-machine escape hatch, not tracked by this repo. `if ... fi`, not `[[ ]] &&`: a bare
# trailing `&&` makes this file's exit status 1 whenever the file is absent, which
# surfaces as a stale nonzero $? at the very first interactive prompt.
if [[ -f ~/.zshrc.local ]]; then
  source ~/.zshrc.local
fi
true
