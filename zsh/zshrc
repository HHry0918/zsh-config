### procs
# procs 0.14.1+ renamed --completion-out to --gen-completion-out (verified against
# tagged source, src/opt.rs). Never compare version numbers — probe for the capability:
# try the new spelling first, fall back to the old one, skip silently if neither exists.
if command -v procs >/dev/null; then
  if procs --gen-completion-out zsh >/dev/null 2>&1; then
    _procs_flag=--gen-completion-out
  elif procs --completion-out zsh >/dev/null 2>&1; then
    _procs_flag=--completion-out
  else
    _procs_flag=
  fi
  if [[ -n $_procs_flag ]]; then
    _procs_f=~/.cache/zsh/procs.zsh
    if [[ ! -s $_procs_f || $_procs_f -ot ${commands[procs]} ]]; then
      mkdir -p ~/.cache/zsh
      _procs_tmp=$(mktemp "${_procs_f}.XXXXXX")
      if procs $_procs_flag zsh | command sed 's/^_procs "\$@"$/compdef _procs procs/' >| "$_procs_tmp" \
          && [[ -s $_procs_tmp ]]; then
        # No trailing $ anchor above (unlike the original): a generator-output change
        # that no longer matches just means the compdef line below is appended instead
        # of substituted in place — degrades to "still works", not "silently broken".
        grep -q '^compdef _procs procs$' "$_procs_tmp" || print -r -- 'compdef _procs procs' >>| "$_procs_tmp"
        mv "$_procs_tmp" $_procs_f
      else
        rm -f "$_procs_tmp"
      fi
    fi
    [[ -s $_procs_f ]] && source $_procs_f
  fi
  unset _procs_flag _procs_f _procs_tmp
fi

### re-promote Homebrew's GNU coreutils (gnubin) above the
### system BSD tools — undoes damage done between .zshenv and here on macOS login shells.
#
# Ghostty (like Terminal.app) starts every new window as a LOGIN shell on macOS, so the
# startup order is .zshenv -> /etc/zprofile -> .zprofile -> .zshrc (this file). /etc/
# zprofile runs Apple's `path_helper`, which rewrites PATH to put /usr/bin:/bin:/usr/sbin
# :/sbin first — *after* zsh/zshenv already prepended the gnubin shim, silently demoting
# it back behind the BSD `sed`, `dircolors`, etc. these dotfiles assume are GNU. This runs
# after the Homebrew shellenv eval below on purpose: that eval also rewrites PATH
# (re-prepending $prefix/bin/sbin), so gnubin must be re-promoted *after* it, not before.
#
# Re-running the exact same prepend as zsh/zshenv is safe and not a duplicate: PATH has
# `typeset -U` set there, which keeps only the leftmost occurrence of a path already
# present — so this promotes gnubin back to the front rather than adding a second copy.
if [[ "$OSTYPE" == darwin* ]]; then
  for _brew_prefix in /opt/homebrew /usr/local; do
    if [[ -x "$_brew_prefix/bin/brew" ]]; then
      export PATH="$_brew_prefix/bin:$_brew_prefix/sbin:$PATH"
      for _gnubin in "$_brew_prefix"/opt/*/libexec/gnubin(N); do
        [[ -d "$_gnubin" ]] && export PATH="$_gnubin:$PATH"
      done
      break
    fi
  done
  unset _brew_prefix _gnubin
fi

