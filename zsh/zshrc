### _zcache helper
# usage: _zcache <name> <cmd...>  — evals cached output, regenerates if binary is newer.
# Generates to a temp file first and requires exit 0 + non-empty output before installing
# it as the cache: a renamed/removed flag on the underlying tool (e.g. procs 0.14 renaming
# --completion-out to --gen-completion-out) must degrade to "no completion" on the next
# start, not leave a permanently-stale, newer-than-binary cache sourced on every startup.
_zcache() {
  local name=$1; shift
  local f=~/.cache/zsh/$name.zsh bin=${commands[$1]}
  [[ -n $bin ]] || return
  if [[ ! -s $f || $f -ot $bin ]]; then
    mkdir -p ~/.cache/zsh
    local tmp; tmp=$(mktemp "${f}.XXXXXX")
    if "$@" >| "$tmp" && [[ -s $tmp ]]; then
      mv "$tmp" "$f"
    else
      rm -f "$tmp"
    fi
  fi
  [[ -s $f ]] && source $f
}

