# Template only — never sourced directly, never filled with real values in this repo.
#
# Copy this file to ~/.zshenv.secrets (chmod 600) and fill in real values there.
# ~/.zshenv (this repo's zsh/zshenv) sources ~/.zshenv.secrets automatically if present.
#
#   cp zsh/zshenv.secrets.template ~/.zshenv.secrets
#   chmod 600 ~/.zshenv.secrets
#   $EDITOR ~/.zshenv.secrets

### TestRail
export TESTRAIL_API_KEY="<TESTRAIL_API_KEY>"

### Digital Ocean
export DIGITALOCEAN_API_TOKEN="<DIGITALOCEAN_API_TOKEN>"

### New Relic
export NEW_RELIC_API_KEY="<NEW_RELIC_API_KEY>"

### Atlassian / Bitbucket
export BITBUCKET_TOKEN="<BITBUCKET_TOKEN>"
# Derived Basic-auth for Atlassian remote MCP (base64 of login:token), consumed by
# ~/.claude.json. Guarded: this file runs on every zsh invocation, so without the
# guard this forks printf+base64 on every single shell startup.
[[ -n $ATLASSIAN_MCP_AUTH ]] || export ATLASSIAN_MCP_AUTH="$(printf '%s' "$ATLASSIAN_LOGIN:$ATLASSIAN_PASSWORD" | base64 -w0)"

### Jenkins
export JENKINS_TOK="<JENKINS_TOK>"
export JENKINS_BEACH_DEV_USR="<JENKINS_BEACH_DEV_USR>"
export JENKINS_BEACH_DEV_TOK="<JENKINS_BEACH_DEV_TOK>"

### Slack
export SLACK_SVT_REPORT_TOKEN="<SLACK_SVT_REPORT_TOKEN>"
export SIGNING_SECRET="<SIGNING_SECRET>"

### DB
export SVT_PWD="<SVT_PWD>"
